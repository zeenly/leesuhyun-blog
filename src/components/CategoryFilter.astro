---
import { CATEGORIES } from "@consts";
import { categoryHref } from "@lib/utils";
---

<nav aria-label="Categories" class="animate flex flex-wrap gap-2 text-sm">
  {
    CATEGORIES.map((category) => (
      <a
        href={categoryHref(category)}
        class="rounded-sm border border-foreground/15 px-2 py-1 transition-colors duration-300 ease-in-out hover:bg-foreground/5 hover:text-heading focus-visible:bg-foreground/5 focus-visible:text-heading"
      >
        {category}
      </a>
    ))
  }
</nav>
