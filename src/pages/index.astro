---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS, CONSULT_URL, CHURCH_URL } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="font-semibold text-heading">이수현</h1>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <p>이천에서 고등부 영어만 가르칩니다. 등교 전 아침, 주 4회입니다.</p>
            <p>
              성적이 멈춘 자리에는 대개 이유가 있습니다. 대부분은 학생이 게을러서가 아닙니다.<br />
              혼자 남는 시간에 무엇을 할지 정해주고, 해낸 만큼을 봅니다.
            </p>
            <p>숫자는 차갑게 읽고, 사람은 따뜻하게 봅니다.</p>
            <p>
              수업 이야기는 <a href="/class/class-principles">수업 원칙</a>에, 문의는
              <a href={CONSULT_URL} target="_blank" rel="noopener noreferrer">상담 문의</a>로 받습니다.<br />
              주일에는
              <a href={CHURCH_URL} target="_blank" rel="noopener noreferrer">씨앗교회</a>에서
              예배를 준비합니다.
            </p>
            <p class="pt-4"><em>포기하지 않은 학생에게, 포기하지 않는 선생님.</em></p>
          </article>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-heading">
              Latest posts
            </h2>
            <Link href="/blog"> See all posts </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-heading">
              Recent projects
            </h2>
            <Link href="/projects"> See all projects </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              projects.map((project) => (
                <li>
                  <ArrowCard entry={project} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-heading">Contact</h2>
          <ul class="not-prose flex flex-wrap gap-2">
            {
              SOCIALS.map((SOCIAL, i) => {
                const external = SOCIAL.HREF.startsWith("http");
                return (
                  <li class="flex gap-x-2 text-nowrap">
                    <Link href={SOCIAL.HREF} external={external}>
                      {SOCIAL.NAME}
                    </Link>
                    {i < SOCIALS.length - 1 && "/"}
                  </li>
                );
              })
            }
          </ul>
          <p class="text-sm text-foreground/70">평일 저녁 회신</p>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
