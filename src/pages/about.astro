---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { ABOUT } from "@consts";
---

<Layout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <h1 class="animate text-3xl font-semibold text-heading">About</h1>
    <article class="animate mt-10">
      <h2>교육 철학</h2>
      <p>(작성 예정)</p>

      <h2>수업 방식</h2>
      <p>(작성 예정)</p>

      <h2>등록 안내</h2>
      <p>(작성 예정)</p>
    </article>
  </Container>
</Layout>
